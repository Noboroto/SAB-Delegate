# Names only, no values. Copy to .env (gitignored) and fill in locally.
# Entries marked (secret) must never be committed, logged or passed as a build arg.

# Legacy bot in root/: comma-separated Discord bot tokens (secret)
TOKENS=token1,token2

# Server: runtime
APP_ENV=
DISCORD_TOKEN= # (secret)
DISCORD_CLIENT_ID=
DISCORD_ALLOWED_APP_IDS=
DISCORD_DEV_GUILD_ID=
ADMIN_GUILD_ID=
MIGRATION_PENDING=
COMMANDS_FORCE_RESET=
LOG_LEVEL=
DB_POOL_MAX=
PGBOSS_POOL_MAX=
PGBOSS_WORKERS_ENABLED=

# Server: REST API and dashboard login. Off unless APP_URL is set; then the two
# secrets are required, and in production so is the proxy hop list.
APP_URL=
DISCORD_CLIENT_SECRET= # (secret)
BETTER_AUTH_SECRET= # (secret, at least 32 characters)
TRUSTED_PROXY_IPS=
# MCP endpoint at /mcp for AI agents holding an API key. On with the REST API; false removes the route.
MCP_ENABLED=

# Postgres: runtime role
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD= # (secret)

# Postgres: migrate role (release job only)
POSTGRES_MIGRATE_USER=
POSTGRES_MIGRATE_PASSWORD= # (secret)

# Postgres: backup role (backup job only)
POSTGRES_BACKUP_USER=
POSTGRES_BACKUP_PASSWORD= # (secret)

# Backup and release jobs
BACKUP_ENABLED=
BACKUP_KEEP_DAILY=
BACKUP_KEEP_PRE_MIGRATE=

# Owner machine only: script that cleans up the legacy bot's slash commands
LEGACY_BOT_TOKEN= # (secret)
LEGACY_CLIENT_ID=

# Test and dev switches
TEST_REQUIRE_DB=
SAB_DEPS_READY=
