#!/usr/bin/env bash

# Swaps the interpreter when husky started this hook under `sh`; must run
# before anything bash-4-only is parsed.
. "$(dirname "$0")/lib/require-bash.sh"
# shellcheck source=lib/hook-env.sh
. "$(dirname "$0")/lib/hook-env.sh"

set -Eeuo pipefail

HOOK_NAME="PRE-PUSH"
# shellcheck source=lib/step-runner.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/step-runner.sh"
# shellcheck source=lib/gate-stamp.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/gate-stamp.sh"
# shellcheck source=lib/compose-check.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/compose-check.sh"
trap on_hook_failure ERR

ZERO_SHA="0000000000000000000000000000000000000000"
PUSHED_FILES=()

# Saved so the locked re-run of this hook can be fed the same refs.
REFS="$(cat)"

while read -r local_ref local_sha remote_ref remote_sha; do
  local_ref="${local_ref%$'\r'}"
  local_sha="${local_sha%$'\r'}"
  remote_sha="${remote_sha%$'\r'}"

  if [[ -z "${local_ref:-}" || "$local_sha" == "$ZERO_SHA" ]]; then
    continue
  fi

  if [[ "$remote_sha" == "$ZERO_SHA" ]]; then
    range="$(git hash-object -t tree /dev/null)..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  mapfile -t ref_files < <(git diff --name-only --diff-filter=ACMRD "$range" --)
  PUSHED_FILES+=("${ref_files[@]}")
done <<<"$REFS"

if ((${#PUSHED_FILES[@]} == 0)); then
  exit 0
fi

MARKDOWN_ONLY=true
for file in "${PUSHED_FILES[@]}"; do
  case "$file" in
    *.md) ;;
    *)
      MARKDOWN_ONLY=false
      break
      ;;
  esac
done

if [[ "$MARKDOWN_ONLY" == true ]]; then
  echo "markdown-only push: skip code checks"
  exit 0
fi

# shellcheck source=lib/heavy-lock.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/heavy-lock.sh"
heavy_lock_hook SAB-Delegate pre-push "$0" "$@" <<<"$REFS"

# What the pushed range requires; same split as pre-commit. The legacy gates
# depend only on root/**, so they run when the range touches it.
ROOT_TOUCHED=false
WORKSPACE_TOUCHED=false
for file in "${PUSHED_FILES[@]}"; do
  case "$file" in
    *.md) ;;
    root/*) ROOT_TOUCHED=true ;;
    compose.yml | coolify.compose.yml | dockerfile | .dockerignore | .husky/*) ;;
    *) WORKSPACE_TOUCHED=true ;;
  esac
done

# Pushing main deploys production, so the gates re-run unless pre-commit
# already cleared these exact bytes. Prettier only checks here: a push has
# nothing to re-stage into.
if gate_stamp_is_current; then
  echo "✓ workspace + legacy gates: skipped - working tree is byte-identical to what pre-commit already cleared (lib/gate-stamp.sh)"
else
  if [[ "$WORKSPACE_TOUCHED" == true ]]; then
    run_step "prettier (workspace, check only)" pnpm formatter:check
    # Generated once here; the flag makes every nested pnpm call skip it.
    run_step "generate deps" pnpm generate:deps
    export SAB_DEPS_READY=1
    run_step "eslint (workspace, --max-warnings 0)" pnpm lint
    run_step "typecheck (workspace)" pnpm typecheck
    run_step "knip (unused files, exports, dependencies)" pnpm knip
    if suite_stamp_is_current; then
      echo "✓ vitest (workspace): skipped - the full suite already passed on these exact bytes"
    else
      run_step "vitest (workspace)" pnpm test
      suite_stamp_write
    fi
    gate_stamp_write
  fi
  if [[ "$ROOT_TOUCHED" == true ]]; then
    run_step "prettier (root, check only)" pnpm --dir root pretty
    run_step "typecheck (root)" pnpm --dir root typecheck
    run_step "eslint (root, --max-warnings 0)" pnpm --dir root lint
    run_step "vitest (legacy manifests guard)" \
      pnpm exec vitest run scripts/legacy-lockfile.guard.test.ts
  fi
fi

# Cheap and catches the compose errors that only surface as a failed Coolify
# deploy after the push.
run_step "docker compose config (compose files)" compose_check
