#!/usr/bin/env bash

# Swaps the interpreter when husky started this hook under `sh`; must run
# before anything bash-4-only is parsed.
. "$(dirname "$0")/lib/require-bash.sh"
# shellcheck source=lib/hook-env.sh
. "$(dirname "$0")/lib/hook-env.sh"

# Not inherited: husky starts hooks with `sh -e`, but the re-exec above cannot
# carry `-e` across (bash does not export SHELLOPTS). Without it a failing `cat`
# or `sed` below leaves the message empty, every grep misses, and the hook exits
# 0 having checked nothing.
set -euo pipefail

# Block "Claude"/"Anthropic"/"Codex"/"ChatGPT" mentions in commit messages
# (exception: bare "CLAUDE.md" references — this repo has no CLAUDE.md, but a
# line explaining that still has to be committable).
MSG_FILE="$1"

# Only what the author wrote is checked. Git appends "#" comment lines (staged
# paths, branch) and, for `commit -v`, a scissors line followed by the whole
# diff; a diff that merely contains one of the words below must not block an
# otherwise clean message. The CLAUDE.md token itself (not the whole line) is
# removed so a line like "see CLAUDE.md" still exposes any OTHER remaining
# "Claude" mention.
STRIPPED=$(
  sed '/^# -* >8 -*$/,$d' "$MSG_FILE" |
    git stripspace --strip-comments |
    sed -E 's/CLAUDE\.md//Ig'
)

for word in claude anthropic codex chatgpt; do
  if grep -iq "$word" <<<"$STRIPPED"; then
    echo "ERROR: Commit message contains '$word'. Remove it before committing."
    if [[ "$word" == claude ]]; then
      echo "       (References to CLAUDE.md are allowed.)"
    fi
    exit 1
  fi
done
