#!/usr/bin/env bash

# A flag inherited from the calling shell would make every nested pnpm skip
# artifact generation and gate on stale output; only this hook may set it.
unset SAB_DEPS_READY

# Swaps the interpreter when husky started this hook under `sh`; must run
# before anything bash-4-only is parsed.
. "$(dirname "$0")/lib/require-bash.sh"
# shellcheck source=lib/hook-env.sh
. "$(dirname "$0")/lib/hook-env.sh"

# `-E` so the ERR trap below is inherited by functions and subshells.
set -Eeuo pipefail

HOOK_NAME="PRE-COMMIT"
# shellcheck source=lib/step-runner.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/step-runner.sh"
# shellcheck source=lib/gate-stamp.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/gate-stamp.sh"
# shellcheck source=lib/compose-check.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/compose-check.sh"
trap on_hook_failure ERR

# Diff output goes through files, not `< <(git ...)`: a failing process
# substitution is swallowed by `set -e` and would leave an empty list, which
# reads as "nothing to check". `--no-renames` lists a rename as delete + add, so
# the old path (a .ts renamed to .md, say) is still seen by the gates below.
HOOK_TMP="$(mktemp -d)"
trap 'rm -rf "$HOOK_TMP"' EXIT
git diff --cached --name-only --no-renames --diff-filter=ACMRDT -z >"$HOOK_TMP/staged"
mapfile -d '' STAGED_FILES <"$HOOK_TMP/staged"

STAGED_COUNT=$(
  git diff --cached --name-only -z |
    tr -cd '\0' |
    wc -c |
    tr -d ' '
)

if ((STAGED_COUNT > 29)); then
  echo "ERROR: $STAGED_COUNT staged files exceeds the 29-file limit. Split the commit."
  echo "Split into the FEWEST commits that fit: ceil(total/29), not one per concern."
  exit 1
fi

if ((${#STAGED_FILES[@]} == 0)); then
  exit 0
fi

# A file may sit above LINE_LIMIT, but this commit may not push it higher: the
# count is compared against HEAD, so the debt can only shrink. A rename is read
# with `-M` here (unlike the file list above) so the new path is compared with
# the OLD path's HEAD size; otherwise moving an oversize file would look like a
# brand-new one and be refused, or, worse, be judged against an empty base.
LINE_LIMIT=1000
OVERSIZE_GREW=()
git diff --cached --name-status -M -z --diff-filter=ACMRT >"$HOOK_TMP/status"
while IFS= read -r -d '' status; do
  case "$status" in
    R*)
      IFS= read -r -d '' base_path
      IFS= read -r -d '' file
      ;;
    *)
      IFS= read -r -d '' file
      base_path="$file"
      ;;
  esac
  case "$file" in
    *.ts | *.tsx | *.mts | *.cts | *.js | *.jsx | *.mjs | *.cjs | *.css | *.scss) ;;
    *) continue ;;
  esac
  staged_lines=$(git show ":$file" 2>/dev/null | wc -l | tr -d ' ')
  ((staged_lines > LINE_LIMIT)) || continue
  # A file new in this commit has no HEAD version; `git show` failing under
  # pipefail would trip the ERR trap and exit 128 without this message.
  head_lines=0
  if git cat-file -e "HEAD:$base_path" 2>/dev/null; then
    head_lines=$(git show "HEAD:$base_path" | wc -l | tr -d ' ')
  fi
  if ((staged_lines > head_lines)); then
    OVERSIZE_GREW+=("$file ($head_lines -> $staged_lines)")
  fi
done <"$HOOK_TMP/status"

if ((${#OVERSIZE_GREW[@]} > 0)); then
  echo "ERROR: these files pass $LINE_LIMIT lines and this commit makes them longer:"
  printf '  %s\n' "${OVERSIZE_GREW[@]}"
  exit 1
fi

# Every commit, markdown included, is scanned: a token pasted into a doc or a
# memory leaks as surely as one in code. Fails closed when gitleaks is missing.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "ERROR: gitleaks is not installed (brew install gitleaks); the staged secret scan cannot run."
  exit 1
fi
if ! gitleaks git --staged --redact --no-banner --config .gitleaks.toml >/dev/null 2>&1; then
  echo "ERROR: gitleaks found a secret in the staged changes. Values are redacted:"
  gitleaks git --staged --redact --no-banner --config .gitleaks.toml 2>&1 | grep -vE '^\s*$' || true
  exit 1
fi

# What the staged files require. Markdown never gates code. Root-level infra
# (compose files, the legacy image file, .dockerignore, docker/) and hook
# scripts have their own cheap checks below instead of the code gates. Anything
# else outside root/ belongs to the pnpm workspace; root/ is the legacy bot and
# keeps its own gates until cutover. Deletions count: removing a workspace file
# can break it, and a rename shows up as a deletion of the old path.
ROOT_GATED=false
WORKSPACE_GATED=false
INFRA_TOUCHED=false
MD_TOUCHED=false
RUN_COMPOSE_CHECK=false
HOOK_FILES=()
for file in "${STAGED_FILES[@]}"; do
  case "$file" in
    *.md) MD_TOUCHED=true ;;
    root/*) ROOT_GATED=true ;;
    compose.yml | coolify.compose.yml | docker/test-db.compose.yml | dockerfile | .dockerignore)
      INFRA_TOUCHED=true
      RUN_COMPOSE_CHECK=true
      ;;
    docker/*) INFRA_TOUCHED=true ;;
    .husky/*)
      INFRA_TOUCHED=true
      HOOK_FILES+=("$file")
      ;;
    *) WORKSPACE_GATED=true ;;
  esac
done

# Repo-wide guards that no code gate would otherwise exercise. A workspace run
# already executes every scripts/*.test.ts through `pnpm test`, so they are
# only listed here for commits that skip that suite.
GUARD_SPECS=()
if [[ "$WORKSPACE_GATED" != true ]]; then
  if [[ "$INFRA_TOUCHED" == true || "$ROOT_GATED" == true ]]; then
    GUARD_SPECS=(scripts/*.guard.test.ts)
  elif [[ "$MD_TOUCHED" == true ]]; then
    GUARD_SPECS=(scripts/no-untracked-references.guard.test.ts)
  fi
fi

# Docs and memory commits skip the code gates and never wait on the heavy lock.
# They still run the untracked-reference guard: a doc is where a dangling path
# gets written.
if [[ "$ROOT_GATED" != true && "$WORKSPACE_GATED" != true && "$INFRA_TOUCHED" != true ]]; then
  echo "markdown-only commit: skip code checks"
  run_step "vitest (repo guards)" pnpm exec vitest run "${GUARD_SPECS[@]}"
  exit 0
fi

# Everything past the markdown exit runs a vitest process at least (the repo
# guards), so it waits for the machine-wide heavy lock. Every cheap check above
# (file cap, line rule, secret scan, classification) needs no lock and is simply
# repeated by the re-run under it.
# shellcheck source=lib/heavy-lock.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/heavy-lock.sh"
heavy_lock_hook SAB-Delegate pre-commit "$0" "$@"

# A hook that fails to parse silently disables the only quality gate.
hooks_syntax_check() {
  local file
  for file in "$@"; do
    # A deleted hook is in the staged set but has nothing left to parse.
    if [[ -f "$file" ]]; then
      bash -n "$file"
    fi
  done
}

if ((${#HOOK_FILES[@]} > 0)); then
  run_step "bash syntax (hooks)" hooks_syntax_check "${HOOK_FILES[@]}"
fi

# prettier --write must only re-stage files that are fully staged: `git add` on
# a partially staged file would sweep the unstaged work-in-progress into the
# commit. Classified BEFORE prettier rewrites anything.
PARTIALLY_STAGED=()
FULLY_STAGED=()
restage_after_prettier() {
  if ((${#FULLY_STAGED[@]} > 0)); then
    git add -- "${FULLY_STAGED[@]}"
  fi
  if ((${#PARTIALLY_STAGED[@]} > 0)); then
    echo "⚠ Only PART of these files is staged, so the hook did not 'git add' them."
    echo "  Prettier formatted them on disk; stage the hunks you want yourself:"
    printf '    %s\n' "${PARTIALLY_STAGED[@]}"
  fi
}

classify_staged() {
  local file
  PARTIALLY_STAGED=()
  FULLY_STAGED=()
  for file in "$@"; do
    if git diff --quiet -- "$file"; then
      FULLY_STAGED+=("$file")
    else
      PARTIALLY_STAGED+=("$file")
    fi
  done
}

# Workspace gates, cheapest refusal first: prettier -> typecheck -> eslint ->
# knip -> vitest. Type-aware eslint builds the same TypeScript programs as tsc
# and takes several times longer, so a type error must not wait behind it.
# Typecheck cannot move above generate-deps: it reads the built shared package
# and would answer from the previous build. knip runs before the suite so an
# unused export fails in seconds, not after the full run.
if [[ "$WORKSPACE_GATED" == true ]]; then
  WORKSPACE_FORMATTABLE=()
  for file in "${STAGED_FILES[@]}"; do
    case "$file" in
      root/*) ;;
      *.ts | *.tsx | *.mts | *.cts | *.js | *.jsx | *.mjs | *.cjs | *.json)
        # A deleted file is in the staged set but cannot be formatted or re-added.
        if [[ -e "$file" ]]; then
          WORKSPACE_FORMATTABLE+=("$file")
        fi
        ;;
    esac
  done

  if ((${#WORKSPACE_FORMATTABLE[@]} > 0)); then
    classify_staged "${WORKSPACE_FORMATTABLE[@]}"
    # Explicit file list: only staged files are rewritten, and .prettierignore
    # still applies to them.
    run_step "prettier (workspace, write)" \
      pnpm exec prettier --write --ignore-unknown --log-level warn "${WORKSPACE_FORMATTABLE[@]}"
    restage_after_prettier
  fi

  # Taken after prettier --write so its own edits are not read as concurrent
  # ones; the stamp is written only if the tree is still identical at the end.
  gate_stamp_begin
  # `prettier --write` never fails, so on its own it proves nothing about the
  # bytes just keyed: a file saved while it ran would be stamped as formatted
  # and pre-push would skip its check. Checking after keying closes that window.
  run_step "prettier (workspace, check only)" pnpm formatter:check

  # Generated once here; the flag makes every nested pnpm call skip it.
  run_step "generate deps" pnpm generate:deps
  export SAB_DEPS_READY=1

  run_step "typecheck (workspace)" pnpm typecheck
  # Single-threaded (`--concurrency off`, set in the lint script) on purpose:
  # eslint peak memory follows the worker count. Measured on the shared 16 GB Mac
  # against a larger type-aware monorepo: one thread ~4.4 GB / 49 s, two ~7.4 GB / 36 s, four ~8.0 GB / 46 s, auto past
  # 21 GB. The few seconds saved are not worth leaving under 35% of the shared
  # machine free for the next heavy job.
  run_step "eslint (workspace, --max-warnings 0)" pnpm lint
  run_step "knip (unused files, exports, dependencies)" pnpm knip
  run_step "vitest (workspace)" pnpm test
  suite_stamp_write
fi

# The legacy bot's own gates, only when its files are staged.
if [[ "$ROOT_GATED" == true ]]; then
  ROOT_FORMATTABLE=()
  for file in "${STAGED_FILES[@]}"; do
    case "$file" in
      root/*.ts | root/*.js | root/*.mjs | root/*.json)
        if [[ -e "$file" ]]; then
          ROOT_FORMATTABLE+=("$file")
        fi
        ;;
    esac
  done

  classify_staged "${ROOT_FORMATTABLE[@]}"

  run_step "typecheck (root)" pnpm --dir root typecheck
  run_step "prettier (root, write)" pnpm --dir root pretty-fix
  restage_after_prettier
  run_step "eslint (root, --max-warnings 0)" pnpm --dir root lint
  run_step "typecheck (root, after prettier + eslint)" pnpm --dir root typecheck
fi

# Production installs from root/pnpm-lock.yaml with --frozen-lockfile, so a
# change to it (or to root/package.json) must fail here, not only when a
# workspace file happens to be staged too; the guard list covers it.
if ((${#GUARD_SPECS[@]} > 0)); then
  run_step "vitest (repo guards)" pnpm exec vitest run "${GUARD_SPECS[@]}"
fi

if [[ "$RUN_COMPOSE_CHECK" == true ]]; then
  run_step "docker compose config (compose files)" compose_check
fi

# Last, once every gate the stamp vouches for (workspace and legacy) has passed,
# so pre-push can skip the workspace gates on byte-identical content (see
# lib/gate-stamp.sh). It never vouches for root/: pre-push re-runs those gates
# whenever the pushed range touches that tree.
if [[ "$WORKSPACE_GATED" == true ]]; then
  gate_stamp_write
fi
