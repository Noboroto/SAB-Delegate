{
  "$schema": "https://json.schemastore.org/nest-cli",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      {
        "include": "../assets/*.json",
        "outDir": "dist/assets"
      },
      {
        "include": "../assets/*.txt",
        "outDir": "dist/assets"
      },
      {
        "include": "../assets/*.tsv",
        "outDir": "dist/assets"
      }
    ]
  }
}
