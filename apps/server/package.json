{
  "name": "@sab/server",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "dev": "nest start --watch",
    "prebuild": "pnpm --workspace-root run generate:deps",
    "predev": "pnpm --workspace-root run generate:deps",
    "pretypecheck": "pnpm --workspace-root run generate:deps",
    "typecheck": "tsc --noEmit",
    "db:generate": "node -e \"require('node:fs').rmSync('../../packages/shared/src/generated/zod', { recursive: true, force: true })\" && prisma generate && node scripts/fix-generated-esm.mjs",
    "db:migrate": "prisma migrate deploy",
    "migrate:quickdb": "node dist/tools/migrate-quickdb/main.js",
    "pretest": "pnpm --workspace-root run generate:deps",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.2",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sab/shared": "workspace:*",
    "fastify": "5.12.5",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pg-boss": "12.37.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.16.18",
    "@types/node": "24.12.0",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "prisma-zod-generator": "3.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3"
  }
}
