model Guild {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Discord snowflake; the internal key above never leaves the database.
  discordId String   @unique
  /// Display cache refreshed from Discord; never authoritative.
  name      String?
  /// CHECK (migration `_checks`): one of 'vi', 'en'.
  locale    String   @default("vi")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  config         GuildConfig?
  birthdays      BirthdayEntry[]
  birthdayRuns   BirthdayCompletedDate[]
  birthdayWishes BirthdayWishUsage[]
  notes          NoteEntry[]
  wordGame       WordGameState?
  gameChannels   GameChannel[]
  counting       CountingState?
  scramble       ScrambleState?
  wordle         WordleState?
  gameScores     GameScore[]
  scheduled      ScheduledMessage[]
  auditLogs      AuditLog[]

  chatbot                ChatbotConfig?
  chatbotChannels        ChatbotChannel[]
  chatbotChannelMemories ChatbotChannelMemory[]
  chatbotUserMemories    ChatbotUserMemory[]
  chatbotQuotas          ChatbotUserQuota[]
  chatbotUsages          ChatbotUsage[]
  chatbotTurns           ChatbotTurn[]
}
