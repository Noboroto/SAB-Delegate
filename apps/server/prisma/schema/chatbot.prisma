/// A server's chatbot: whether it answers, and the monthly token allowance every
/// member starts with. The `llm*` columns are an optional override of the global
/// LlmConfig; the key is stored encrypted (AES-256-GCM, key from env
/// LLM_KEY_SECRET) and only its last four characters are ever shown.
/// CHECK (migration `_chatbot`): `defaultMonthlyLimit` is between 0 and 1000000000;
/// the override is all-or-none: either all four `llm*` columns are NULL, or
/// `llmBaseUrl` starts with https:// and has a host, `llmModel` and `llmApiKeyEnc`
/// are non-empty and `llmKeyLast4` has 1 to 4 characters.
model ChatbotConfig {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  guildId             String   @unique @db.Uuid
  enabled             Boolean  @default(false)
  defaultMonthlyLimit Int      @default(100000)
  llmBaseUrl          String?
  llmModel            String?
  llmApiKeyEnc        String?
  llmKeyLast4         String?
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

/// A channel where the bot answers when mentioned. A channel is designated once
/// (`channelId` unique). The number of channels per server is capped by the service.
/// CHECK (migration `_chatbot`): `channelId` is a snowflake.
model ChatbotChannel {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  guildId   String   @db.Uuid
  channelId String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

/// What the bot remembers about a channel, as a summary it rewrote itself.
/// CHECK (migration `_chatbot`): `channelId` is a snowflake, `summary` has at most
/// 2000 characters.
model ChatbotChannelMemory {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  guildId   String   @db.Uuid
  channelId String
  summary   String
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, channelId])
}

/// What the bot remembers about one member of one server; it never leaves that
/// server. `turnsSinceSummary` counts the member's replies since the summary was
/// last rewritten. CHECK (migration `_chatbot`): `userId` is a snowflake,
/// `summary` has at most 2000 characters, `turnsSinceSummary` >= 0.
model ChatbotUserMemory {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  guildId           String   @db.Uuid
  userId            String
  summary           String
  turnsSinceSummary Int      @default(0)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
}

/// A member's own monthly limit, replacing the server default.
/// CHECK (migration `_chatbot`): `userId` is a snowflake, `monthlyLimit` is
/// between 0 and 1000000000.
model ChatbotUserQuota {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  guildId      String   @db.Uuid
  userId       String
  monthlyLimit Int
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
}

/// Tokens a member spent in one month, and the extra allowance granted for that
/// month. `period` is the month in the business time zone, `YYYY-MM`.
/// CHECK (migration `_chatbot`): `userId` is a snowflake, `period` matches
/// `YYYY-MM`, `used` and `bonus` are between 0 and 1000000000.
model ChatbotUsage {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  guildId   String   @db.Uuid
  userId    String
  period    String
  used      Int      @default(0)
  bonus     Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId, period])
  @@index([guildId, period])
}

/// One exchange with the chatbot, kept so the member's conversation outlives the
/// live channel messages and so admins can see what was asked and sent to the
/// model. `triggerMessageId` is unique: a Discord message gets one turn.
/// `failureReason` is a reason code, never provider text. `context` is the
/// snapshot of what the model was given (never image or file bytes); it is
/// Zod-parsed at every read.
/// A row is written as PENDING the moment a mention is taken in, so a restart can
/// answer what it cut off; only a PENDING row ever moves to its final status.
/// `reservedTokens` is the allowance held in `period` for the model call; it is
/// zeroed by whoever settles or refunds it, so a hold is given back at most once.
/// CHECK (migration `_chatbot_turns`): `channelId`, `userId`, `triggerMessageId` and
/// `replyMessageId` are snowflakes, `question` has at most 6000 characters and
/// `answer` at most 12000, the token counts are >= 0, and `answer` is set when
/// `status` is OK. CHECK (migration `_chatbot_turn_pending`): `reservedTokens` is
/// between 0 and 1000000000, `period` is `YYYY-MM` when set, and a held amount
/// comes with its `period`.
model ChatbotTurn {
  id               String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  guildId          String            @db.Uuid
  channelId        String
  userId           String
  triggerMessageId String            @unique
  replyMessageId   String?
  status           ChatbotTurnStatus
  failureReason    String?
  question         String
  answer           String?
  model            String?
  llmSource        String?
  inputTokens      Int               @default(0)
  outputTokens     Int               @default(0)
  estimated        Boolean           @default(false)
  context          Json
  reservedTokens   Int               @default(0)
  period           String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @default(now()) @updatedAt @db.Timestamptz(3)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt(sort: Desc)])
  @@index([guildId, userId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@index([status, createdAt])
}
