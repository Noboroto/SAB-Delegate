model GuildConfig {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  guildId            String   @unique @db.Uuid
  /// CHECK (migration `_checks`): every channel column below is NULL or a 17-20 digit snowflake.
  introChannelId     String?
  logChannelId       String?
  birthdayChannelId  String?
  activityCategoryId String?
  wordChannelId      String?
  /// CHECK (migration `_checks`): >= 200.
  wordMaxWords       Int      @default(3000)
  /// The server's wish list was filled with the built-in wishes; an emptied list stays empty.
  birthdayWishesSeeded Boolean @default(false)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}
