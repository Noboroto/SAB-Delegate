enum ScheduledKind {
  SEND
  COPY
}

enum ScheduledStatus {
  PENDING
  SENDING
  SENT
  CANCELED
  FAILED
}

/// A birthday run claims its day as SENDING with a lease and only becomes DONE
/// after every greeting went out.
enum WishRunStatus {
  SENDING
  DONE
}

enum ActorSource {
  DISCORD
  HTTP
  MCP
  SYSTEM
}

enum ApiKeyMode {
  READ
  WRITE
}

/// The channel games and the word chain, as the leaderboard names them.
enum MiniGame {
  WORD_CHAIN
  COUNTING
  SCRAMBLE
  WORDLE
}

/// Where the meaning of a Vietnamese word came from. NONE: looked up, nothing found;
/// never looked up again.
enum MeaningSource {
  WIKTIONARY
  VNTK
  LLM
  NONE
}

/// How a chatbot turn ended. PENDING: taken in, no outcome yet; OK: the model answered;
/// QUOTA_EXHAUSTED: the member had no tokens left; NOT_CONFIGURED: no model was
/// available; FAILED: the call failed; EXPIRED: closed without a new reply (too old to
/// answer after a restart, no longer a chatbot channel, message gone, or the member was
/// already being answered).
enum ChatbotTurnStatus {
  OK
  QUOTA_EXHAUSTED
  NOT_CONFIGURED
  FAILED
  PENDING
  EXPIRED
}

/// How an address was confirmed: the member typed the code from the mail (CODE), or a
/// manager confirmed it by hand (MANUAL).
enum EmailVerifyMethod {
  CODE
  MANUAL
}
