enum ScheduledKind {
  SEND
  COPY
}

enum ScheduledStatus {
  PENDING
  SENDING
  SENT
  CANCELED
  FAILED
}

/// A birthday run claims its day as SENDING with a lease and only becomes DONE
/// after every greeting went out.
enum WishRunStatus {
  SENDING
  DONE
}

enum ActorSource {
  DISCORD
  HTTP
  MCP
  SYSTEM
}

enum ApiKeyMode {
  READ
  WRITE
}

/// The channel games and the word chain, as the leaderboard names them.
enum MiniGame {
  WORD_CHAIN
  COUNTING
  SCRAMBLE
  WORDLE
}

/// Where the meaning of a Vietnamese word came from. NONE: looked up, nothing found;
/// never looked up again.
enum MeaningSource {
  WIKTIONARY
  VNTK
  LLM
  NONE
}

/// How a chatbot turn ended. OK: the model answered; QUOTA_EXHAUSTED: the member
/// had no tokens left; NOT_CONFIGURED: no model was available; FAILED: the call failed.
enum ChatbotTurnStatus {
  OK
  QUOTA_EXHAUSTED
  NOT_CONFIGURED
  FAILED
}
