{
  "name": "@sab/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Schemas and constants shared by the server and the web app. The only package that depends on zod.",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
