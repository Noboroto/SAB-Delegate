{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["gitleaks"],
  "workspaces": {
    ".": {
      "entry": [
        "knip.json",
        "scripts/*.test.ts",
        "scripts/*.db.spec.ts",
        "scripts/clear-legacy-commands.mjs"
      ],
      "project": ["*.{ts,mjs}", "scripts/**/*.{ts,mjs}"]
    },
    "apps/server": {
      "entry": ["src/main.ts", "src/tools/*/main.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["prisma-zod-generator"],
      "prisma": false
    },
    "apps/web": {
      "entry": [
        "app/**/{page,layout,loading,error,not-found,route,template,default,global-error}.tsx",
        "app/**/route.ts",
        "app/i18n/request.ts",
        "**/*.test.{ts,tsx}"
      ],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/shared": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
