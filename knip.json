{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["gitleaks"],
  "workspaces": {
    ".": {
      "entry": ["knip.json", "scripts/*.test.ts", "scripts/*.db.spec.ts"],
      "project": ["*.{ts,mjs}", "scripts/**/*.{ts,mjs}"]
    },
    "apps/server": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@prisma/client", "prisma-zod-generator"],
      "prisma": false
    },
    "packages/shared": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
